import { Pointer, Theme } from "theme.slint";
import { App, Idle, Player, Stats } from "state.slint";
import { FpsCounter } from "components/fps_counter.slint";
import { StatusToast } from "components/status_toast.slint";
import { IdleScreen } from "screens/idle.slint";
import { Login } from "screens/login.slint";
import { NowPlaying } from "screens/now_playing.slint";
import { Playlists } from "screens/playlists.slint";
import { Queue } from "screens/queue.slint";
import { DevicePicker } from "screens/devices.slint";

// Re-export the shared API so the Rust side can address the globals and structs.
export { Pointer, Theme } from "theme.slint";
export { App, Devices, DeviceItem, Idle, Library, Player, PlaylistItem, QueueItem, Stats } from "state.slint";

export component AppWindow inherits Window {
    title: "Spotify Round";
    width: 1080px;
    height: 1080px;
    background: Theme.bg;
    forward-focus: keys;

    // Keys: F toggles the frame-rate readout. Zero-sized, so it never takes a
    // touch from the screens.
    // Under everything: the gaps between touch targets get the pointer too, so
    // it stays hidden in a kiosk wherever it rests.
    TouchArea {
        mouse-cursor: Pointer.plain;
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == "f" || event.text == "F") {
                Stats.shown = !Stats.shown;
                return accept;
            }
            reject
        }
    }

    // The visualizer covers the screen with an opaque frame once it has faded in,
    // so everything under it is hidden rather than drawn: skip the work.
    // The backdrop: ambient light that follows the artwork palette, a vignette
    // that keeps attention in the centre of the circle, and the progress ring
    // on the rim, drawn opaque in one GPU pass (`src/ring.rs`). The ring sits
    // under the screens, which keep their content well inside it.
    Image {
        width: 100%;
        height: 100%;
        source: Player.ring-frame;
        visible: Idle.fade < 1;
    }

    if App.auth == 2 : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: App.ready ? 1 : 0;
        animate opacity { duration: 700ms; }

        // Swiping left reveals the next screen, so the main screen sits in the
        // middle: queue | now playing | playlists.
        Queue {
            x: (0 - App.screen) * 1080px;
            visible: Idle.fade < 1;
            animate x { duration: 460ms; easing: ease-in-out; }
        }
        NowPlaying {
            x: (1 - App.screen) * 1080px;
            visible: Idle.fade < 1;
            animate x { duration: 460ms; easing: ease-in-out; }
        }
        Playlists {
            x: (2 - App.screen) * 1080px;
            visible: Idle.fade < 1;
            animate x { duration: 460ms; easing: ease-in-out; }
        }

        // The idle visualizer fades in over everything once playback stops.
        IdleScreen { }

        // The device picker is the topmost layer, so it also covers the
        // visualizer if that faded in while it was open.
        DevicePicker { }
    }

    if App.auth != 2 : Login { }

    StatusToast {
        x: (parent.width - self.width) / 2;
        text: App.status;
        shown: App.status-visible;
    }

    FpsCounter { }
}
