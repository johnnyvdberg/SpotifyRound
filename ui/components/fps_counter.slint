// A frame-rate readout, toggled with the F key, `show_fps` in the config, or
// a tap on its place at the top of the circle: on the pill to hide it, on the
// empty spot to show it again. Under it, where the dive is; a long press on
// either spot saves that to `places.txt` (`Stats.save-place`).
//
// It sits at the top of the circle, where the round glass still has room for
// it inside the progress ring, and above everything else so it also shows over
// the visualizer and takes the tap before the screens do.

import { Pointer, Theme } from "../theme.slint";
import { Idle, Stats } from "../state.slint";

export component FpsCounter inherits TouchArea {
    width: Stats.shown ? pill.width : 140px;
    height: 44px;
    x: (1080px - self.width) / 2;
    y: 72px;
    mouse-cursor: Pointer.plain;
    // Set once a press has been held long enough to save, so letting go
    // does not toggle the readout too.
    private property <bool> held: false;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.held = false;
        }
    }
    clicked => {
        if (!root.held) {
            Stats.shown = !Stats.shown;
        }
    }
    Timer {
        interval: 800ms;
        running: root.pressed && !root.held;
        triggered => {
            root.held = true;
            Stats.save-place();
        }
    }
    Timer {
        interval: 2s;
        running: Stats.saved != "";
        triggered => {
            Stats.saved = "";
        }
    }

    // A negative GPU time means this adapter has no timestamp queries and no
    // V3D busy counters: say so rather than showing the display's frame period.
    private property <string> gpu-text: Stats.scene-gpu-ms >= 0
        ? "\{round(Stats.scene-gpu-ms * 10) / 10} ms"
        : "—";
    private property <string> display-gpu-text: Stats.display-gpu-ms >= 0
        ? "\{round(Stats.display-gpu-ms * 10) / 10} ms"
        : "—";

    pill := Rectangle {
        width: max(140px, label.preferred-width + 48px);
        height: 44px;
        border-radius: 22px;
        background: #000000b0;
        border-width: 1px;
        border-color: Theme.hairline;
        visible: Stats.shown;

        label := Text {
            width: parent.width;
            height: parent.height;
            // The scene's own rate only means something while it is drawing.
            text: Idle.active
                ? "\{Stats.display} fps · scene \{Stats.scene} · \{round(Stats.scene-ms * 10) / 10} ms · gpu \{root.gpu-text}"
                : "\{Stats.display} fps · ui \{round(Stats.display-ms * 10) / 10} ms · gpu \{root.display-gpu-text}";
            color: Theme.ink;
            font-family: Theme.font;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: 50px;
        x: (root.width - self.width) / 2;
        width: place.preferred-width + 32px;
        height: 32px;
        border-radius: 16px;
        background: #000000b0;
        visible: Stats.saved != "" || (Stats.shown && Idle.active && Stats.place != "");

        place := Text {
            width: parent.width;
            height: parent.height;
            text: Stats.saved != "" ? Stats.saved : Stats.place;
            color: Theme.ink;
            font-family: Theme.font;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
