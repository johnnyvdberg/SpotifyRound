// Indeterminate spinner, rotated by the animation tick.

import { Theme } from "../theme.slint";

export component Spinner inherits Rectangle {
    in property <length> size: 44px;

    width: size;
    height: size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 9px;
        stroke-line-cap: round;
        commands: "M 50 10 A 40 40 0 0 1 90 50";
        transform-rotation: Theme.spin * 1deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
}