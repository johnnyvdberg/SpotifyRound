// Vector icon set, drawn with paths so the icons stay crisp at any size and
// need no image assets.

import { Theme } from "../theme.slint";

component Glyph inherits Path {
    in property <length> weight: 2px;
    in property <brush> tint: Theme.ink;

    width: 100%;
    height: 100%;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: weight;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component SolidGlyph inherits Path {
    in property <brush> tint: Theme.ink;
    in property <length> edge: 1.6px;

    width: 100%;
    height: 100%;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke: tint;
    stroke-width: edge;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component IconGlyph inherits Rectangle {
    in property <string> kind: "play";
    in property <length> size: 30px;
    in property <brush> tint: Theme.ink;
    in property <length> thickness: 2px;

    width: size;
    height: size;
    background: transparent;

    // transport ---------------------------------------------------------
    if kind == "play" : SolidGlyph {
        tint: root.tint;
        commands: "M9 6.1 18.7 12 9 17.9 Z";
    }

    if kind == "pause" : Rectangle {
        background: transparent;
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.18;
            width: parent.width * 0.16;
            height: parent.height * 0.64;
            border-radius: 2px;
            background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.56;
            y: parent.height * 0.18;
            width: parent.width * 0.16;
            height: parent.height * 0.64;
            border-radius: 2px;
            background: root.tint;
        }
    }

    if kind == "next" : Rectangle {
        background: transparent;
        SolidGlyph {
            x: parent.width * 0.08;
            y: 0;
            width: parent.width * 0.84;
            height: parent.height;
            tint: root.tint;
            commands: "M6.5 5.6 15.6 12 6.5 18.4 Z";
        }
        Rectangle {
            x: parent.width * 0.76;
            y: parent.height * 0.18;
            width: parent.width * 0.13;
            height: parent.height * 0.64;
            border-radius: 1.5px;
            background: root.tint;
        }
    }

    if kind == "previous" : Rectangle {
        background: transparent;
        SolidGlyph {
            x: parent.width * 0.08;
            y: 0;
            width: parent.width * 0.84;
            height: parent.height;
            tint: root.tint;
            commands: "M17.5 5.6 8.4 12 17.5 18.4 Z";
        }
        Rectangle {
            x: parent.width * 0.11;
            y: parent.height * 0.18;
            width: parent.width * 0.13;
            height: parent.height * 0.64;
            border-radius: 1.5px;
            background: root.tint;
        }
    }

    // toggles -----------------------------------------------------------
    if kind == "shuffle" : Glyph {
        tint: root.tint;
        weight: root.thickness;
        commands: "M3 7h3.6L16 17h4 M17 14l3 3-3 3 M3 17h3.6L16 7h4 M17 4l3 3-3 3";
    }

    if kind == "repeat" : Glyph {
        tint: root.tint;
        weight: root.thickness;
        commands: "M5 9.5V9a4 4 0 0 1 4-4h10 M16 2.5 19 5.5l-3 3 M19 14.5V15a4 4 0 0 1-4 4H5 M8 21.5l-3-3 3-3";
    }

    if kind == "repeat-one" : Rectangle {
        background: transparent;
        Glyph {
            tint: root.tint;
            weight: root.thickness;
            commands: "M5 9.5V9a4 4 0 0 1 4-4h10 M16 2.5 19 5.5l-3 3 M19 14.5V15a4 4 0 0 1-4 4H5 M8 21.5l-3-3 3-3";
        }
        Glyph {
            tint: root.tint;
            weight: 1.6px;
            commands: "M10.6 10.4 12.3 9.2v5.4";
        }
    }

    if kind == "note" : Rectangle {
        background: transparent;
        Glyph {
            tint: root.tint;
            weight: 2.2px;
            commands: "M10 17.5V6.8l9-1.8v10";
        }
        Rectangle {
            x: parent.width * 0.24;
            y: parent.height * 0.66;
            width: parent.width * 0.26;
            height: parent.height * 0.26;
            border-radius: self.width / 2;
            background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.71;
            y: parent.height * 0.58;
            width: parent.width * 0.26;
            height: parent.height * 0.26;
            border-radius: self.width / 2;
            background: root.tint;
        }
    }

    if kind == "spotify" : Glyph {
        tint: root.tint;
        weight: 2.5px;
        commands: "M3.8 7.6c5.1-1.7 11.1-1.3 15.8 1 M3.2 12.4c4.6-1.3 9.9-1 13.9.9 M4.2 17c3.7-1.1 7.8-.8 11.2.8";
    }

    // output devices ------------------------------------------------------
    if kind == "speaker" : Rectangle {
        background: transparent;
        Glyph {
            tint: root.tint;
            weight: 1.9px;
            commands: "M3.8 9.6h3.3L12.6 5.3v13.4l-5.5-4.3H3.8z";
        }
        Glyph {
            tint: root.tint;
            weight: 1.7px;
            commands: "M15.9 9.3a4.2 4.2 0 0 1 0 5.4 M18.6 6.7a8 8 0 0 1 0 10.6";
        }
    }

    if kind == "computer" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M3.6 5.4h16.8v10.6H3.6z M9.4 19.8h5.2 M12 16v3.8";
    }

    if kind == "phone" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M8.8 3.4h6.4v17.2H8.8z M10.8 18.6h2.4";
    }

    if kind == "tv" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M6.6 3.4 12 7.1l5.4-3.7 M3.8 7.1h16.4v11.6H3.8z";
    }

    if kind == "car" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M4.2 15.6h15.6 M5.8 15.6l1.6-4.8h9.2l1.6 4.8 M7.2 18.4h1.6 M15.2 18.4h1.6";
    }

    // navigation ----------------------------------------------------------
    if kind == "chevron" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M9.4 6.2 15.2 12l-5.8 5.8";
    }

    if kind == "close" : Glyph {
        tint: root.tint;
        weight: 1.9px;
        commands: "M6.6 6.6l10.8 10.8 M17.4 6.6 6.6 17.4";
    }
}
