// Shared application state.
//
// All values are written from Rust; the UI only reads them and emits commands
// through the `App` callbacks.

export struct PlaylistItem {
    title: string,
    subtitle: string,
    cover: image,
    uri: string,
}

export struct QueueItem {
    title: string,
    subtitle: string,
    cover: image,
    duration: string,
    current: bool,
    uri: string,
}

// One Spotify Connect device playback can be moved to.
// One of a scene's scanner readings: its name, how far along it is, and its
// result (or what it is doing while it runs).
export struct ScanRow {
    name: string,
    progress: float,
    value: string,
}

// A planet, or the star, on the solar tour's minimap.
export struct MapDot {
    x: length,
    y: length,
    size: length,
    color: color,
    label: string,
    current: bool,
}

export struct DeviceItem {
    name: string,
    // Icon kind: "speaker", "computer", "phone", "tv" or "car".
    kind: string,
    // Human name of the kind, e.g. "Speaker".
    detail: string,
    active: bool,
    // False for a device Spotify lists but gives no way to transfer to, such as
    // a Chromecast: it is shown greyed out instead of being hidden.
    selectable: bool,
    id: string,
}

export global Player {
    in-out property <bool> has-track: false;
    in-out property <bool> playing: false;
    in-out property <bool> controls: false;
    in-out property <string> title: "";
    in-out property <string> subtitle: "";
    in-out property <image> cover;
    in-out property <bool> has-cover: false;
    // Animated from Rust (animato tween): 0 = hidden, 1 = fully revealed.
    in-out property <float> reveal: 1;
    // Animated from Rust (animato ping-pong tween) for the queue indicator.
    // Only written while the queue is on screen.
    in-out property <float> pulse: 0;
    // The backdrop and progress ring are rendered on the GPU (`src/ring.rs`). The frames are
    // kept as images so the renderer caches them once, and `ring-frame` names
    // the one to show.
    in-out property <[image]> ring-frames: [];
    in-out property <image> ring-frame;
    in-out property <bool> shuffle: false;
    // Whether Spotify allows skipping in each direction from here.
    in-out property <bool> can-previous: true;
    in-out property <bool> can-next: true;
    // 0 = off, 1 = repeat all, 2 = repeat one
    in-out property <int> repeat: 0;
    // The Spotify Connect device playback is running on.
    in-out property <string> device: "";
    in-out property <string> device-kind: "speaker";
    in-out property <bool> has-device: false;
}

export global Devices {
    // Every device that is open right now, the active one included.
    in-out property <[DeviceItem]> devices: [];
    in-out property <bool> open: false;
    in-out property <bool> loading: false;
    in-out property <string> empty: "";
}

export global Library {
    in-out property <[PlaylistItem]> playlists: [];
    in-out property <string> playlists-subtitle: "";
    in-out property <bool> playlists-loading: false;
    in-out property <string> playlists-empty: "";
    in-out property <string> current-playlist: "";

    in-out property <[QueueItem]> queue: [];
    in-out property <string> queue-subtitle: "";
    in-out property <bool> queue-loading: false;
    in-out property <string> queue-empty: "";
    // Bumped whenever the queue is replaced, so the list can jump back to the
    // item that is playing.
    in-out property <int> queue-revision: 0;
}

export global Idle {
    // Set from Rust: the visualizer is showing (the overlay fades with it).
    in-out property <bool> active: false;
    // 0..1 cross-fade, eased from Rust so it always completes. The overlay stays
    // in the scene at zero opacity: hiding and showing it again leaves stale
    // pixels behind on some compositors.
    in-out property <float> fade: 0;
    // Which visualisation is showing, and the size to draw its frame at. Scenes
    // are picked at random from the renderers that are available.
    in-out property <int> scene: 0;
    in-out property <length> frame-size: 1080px;
    // One frame of the selected visualisation, shown by `frame`.
    in-out property <image> frame;
    // The render targets every scene rotates through, flattened scene by scene.
    // They are kept as images here so the renderer caches them once, instead of
    // seeing a new image every frame.
    in-out property <[image]> frames;
    // A scene's heads-up display: a title, and lines of labels and values
    // (one per line). Empty for scenes without one.
    in-out property <string> hud-title: "";
    in-out property <string> hud-labels: "";
    in-out property <string> hud-values: "";
    in-out property <[ScanRow]> hud-scans: [];
    // The minimap: orbits and route as path commands in a 240-unit square,
    // the planets and the star, and the ship. Hidden while empty.
    // The manoeuvre panel: what the ship is doing and why, and how far
    // through a burn or flyby (negative while coasting). Hidden while empty.
    in-out property <string> man-name: "";
    in-out property <string> man-text: "";
    in-out property <float> man-progress: -1;
    in-out property <string> map-orbits: "";
    in-out property <string> map-route: "";
    in-out property <[MapDot]> map-dots: [];
    in-out property <length> map-ship-x: 0;
    in-out property <length> map-ship-y: 0;

    // A tap anywhere on the visuals returns to the player.
    callback dismiss();
    // A horizontal swipe on the visuals: +1 on to the next stretch of the
    // scene's journey, -1 back to the last. Scenes without one ignore it.
    callback travel(int);

    // The seas of the dive's circuit in the order it sails them, and the one
    // it is in or bound for; empty for a scene without a journey. A long
    // press on the dive opens the chart of them (`charting`).
    in-out property <[string]> seas;
    in-out property <int> sea: 0;
    in-out property <bool> charting: false;
}

// The frame-rate readout. `shown` starts from the configuration and the F key
// flips it; the rates are written from Rust once a second while it shows.
export global Stats {
    in-out property <bool> shown: false;
    // Frames the window presented in the last second.
    in-out property <int> display: 0;
    // The mean milliseconds the UI thread spent drawing each of those frames,
    // and the GPU's per frame (negative when there is no source, as below).
    in-out property <float> display-ms: 0;
    in-out property <float> display-gpu-ms: -1;
    // Frames the idle visualizer drew in the last second, and the mean time
    // its thread spent building and submitting each, in milliseconds.
    in-out property <int> scene: 0;
    in-out property <float> scene-ms: 0;
    // GPU milliseconds per frame, from the V3D's busy counters on the Pi or
    // from timer queries where the adapter has them; negative when no source
    // exists, and the readout shows `—`.
    in-out property <float> scene-gpu-ms: -1;
    // Where the dive is (`Visual::whereabouts`): its visit seed, sea,
    // clock, position and heading; empty for scenes without a journey.
    in-out property <string> place: "";
    // A long press on the readout appends `place` to `places.txt` beside
    // the config; `saved` says how that went, for a moment.
    callback save-place();
    in-out property <string> saved: "";
}

export global App {
    // Screens sit side by side: 0 = queue, 1 = now playing, 2 = playlists.
    in-out property <int> screen: 1;

    // 0 = needs authorization, 1 = waiting for the browser, 2 = connected,
    // 3 = missing client id, 4 = authorization failed
    in-out property <int> auth: 0;
    in-out property <bool> ready: false;
    in-out property <string> auth-url: "";
    in-out property <image> qr;
    in-out property <bool> qr-ready: false;
    in-out property <string> config-path: "";
    in-out property <string> auth-detail: "";

    in-out property <string> status: "";
    in-out property <bool> status-visible: false;

    callback navigate(int);
    callback next();
    callback previous();
    callback toggle-play();
    callback seek(float);
    callback scrub(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback play-playlist(string);
    callback play-queue-item(string);
    callback refresh-playlists();
    callback refresh-queue();
    callback begin-auth();
    // Swipe down on the player opens the screensaver chooser (`choosing`),
    // which shows the scene picked: 0 the Earth, 1 the Nautilus, 2 the planet, 3 the solar tour, -1 any.
    in-out property <bool> choosing: false;
    callback show-visualizer(int);
    // The device pill on the player opens the picker of castable devices.
    callback open-devices();
    callback close-devices();
    callback select-device(string);
    callback refresh-devices();
}
