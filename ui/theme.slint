// Design tokens for the round display.
// Everything is authored at 1080x1080 logical pixels; the physical display is
// circular, so interactive content is kept inside a ~500px radius.

export global Theme {
    out property <color> bg: #07070a;
    out property <color> ink: #f5f5f8;
    out property <color> ink-dim: #9c9ca8;
    out property <color> ink-faint: #63636e;
    out property <color> hairline: #ffffff1f;
    out property <color> surface: #ffffff10;
    out property <color> surface-strong: #ffffff1f;
    out property <string> font: "Inter";

    // Driven from Rust: the accent follows the album art.
    in-out property <color> accent: #1ed760;
    in-out property <color> accent-ink: #04170a;
    in-out property <color> glow: #1ed76055;
    in-out property <color> glow-soft: #1ed7601a;

    // Animation ticks driven from Rust.
    in-out property <float> spin: 0;
}
