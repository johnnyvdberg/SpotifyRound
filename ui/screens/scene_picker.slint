import { Pointer, Theme } from "../theme.slint";
import { App } from "../state.slint";
import { PillButton } from "../components/pill_button.slint";
import { TapArea } from "../components/tap_area.slint";

// One scene to pick: a round window onto it, framed in a bezel of its own
// metal, and its name under it. The picture, bezel and all, is a frame of the
// scene baked by `visuals::tests::picker_thumbnails`.
component SceneTile inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> picture;
    // The scene's own colour, for the glow behind the window.
    in property <color> rim;
    callback picked();

    width: 220px;
    height: 300px;
    background: transparent;

    // A soft glow behind the window, in the scene's own light, brighter
    // under the finger.
    Rectangle {
        x: -24px;
        y: -24px;
        width: 268px;
        height: 268px;
        border-radius: 134px;
        background: @radial-gradient(circle, root.rim.with-alpha(0.4) 0%, root.rim.with-alpha(0.12) 45%, root.rim.with-alpha(0.0) 68%);
        opacity: touch.pressed ? 1 : 0.55;
        animate opacity { duration: 160ms; }
    }

    Image {
        width: 220px;
        height: 220px;
        y: 0;
        source: root.picture;
        opacity: touch.pressed ? 0.82 : 1;
        animate opacity { duration: 120ms; }
    }

    Text {
        y: 234px;
        width: parent.width;
        height: 36px;
        text: root.label;
        color: Theme.ink;
        font-family: Theme.font;
        font-size: 26px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        y: 268px;
        width: parent.width;
        height: 24px;
        text: root.detail;
        color: Theme.ink-faint;
        font-family: Theme.font;
        font-size: 15px;
        horizontal-alignment: center;
    }

    touch := TapArea {
        tapped => { root.picked(); }
    }
}

// The screensaver chooser a swipe down on the player opens: the Earth turning,
// the Nautilus' voyage, the solar tour, the telescope, the microscope, or any
// at random. A tap outside closes it.
export component ScenePicker inherits Rectangle {
    width: 1080px;
    height: 1080px;
    background: transparent;
    visible: App.choosing;

    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, #0d1018f4 0%, #000000f6 60%);
    }

    TapArea {
        tapped => { App.choosing = false; }
    }

    Text {
        y: 150px;
        width: parent.width;
        height: 44px;
        text: "Screensaver";
        color: Theme.ink;
        font-family: Theme.font;
        font-size: 34px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        y: 198px;
        width: parent.width;
        height: 28px;
        text: "Pick what fills the glass";
        color: Theme.ink-faint;
        font-family: Theme.font;
        font-size: 18px;
        horizontal-alignment: center;
    }

    SceneTile {
        x: 540px - self.width * 1.5 - 20px;
        y: 250px;
        label: "Earth";
        picture: @image-url("../images/scenes/earth.png");
        detail: "The planet turning";
        rim: #7cc4ff;
        picked => {
            App.choosing = false;
            App.show-visualizer(0);
        }
    }

    SceneTile {
        x: 540px - self.width / 2;
        y: 250px;
        label: "Nautilus";
        picture: @image-url("../images/scenes/nautilus.png");
        detail: "A voyage under the sea";
        rim: #c9a35a;
        picked => {
            App.choosing = false;
            App.show-visualizer(1);
        }
    }

    SceneTile {
        x: 540px + self.width / 2 + 20px;
        y: 250px;
        label: "Solar tour";
        picture: @image-url("../images/scenes/solar.png");
        detail: "A grand tour of the stars";
        rim: #a99cff;
        picked => {
            App.choosing = false;
            App.show-visualizer(2);
        }
    }

    SceneTile {
        x: 540px - 20px - self.width;
        y: 570px;
        label: "Observatory";
        picture: @image-url("../images/scenes/observatory.png");
        detail: "A night at the telescope";
        rim: #e2bd72;
        picked => {
            App.choosing = false;
            App.show-visualizer(3);
        }
    }

    SceneTile {
        x: 540px + 20px;
        y: 570px;
        label: "Microscope";
        picture: @image-url("../images/scenes/microscope.png");
        detail: "Pond life on a slide";
        rim: #8fc98a;
        picked => {
            App.choosing = false;
            App.show-visualizer(4);
        }
    }

    PillButton {
        x: (parent.width - self.width) / 2;
        y: 890px;
        label: "Surprise me";
        primary: false;
        clicked => {
            App.choosing = false;
            App.show-visualizer(-1);
        }
    }
}
