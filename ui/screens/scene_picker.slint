import { Pointer, Theme } from "../theme.slint";
import { App } from "../state.slint";
import { PillButton } from "../components/pill_button.slint";
import { TapArea } from "../components/tap_area.slint";

// One scene to pick: a round window onto it, and its name under it.
component SceneTile inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    // The window's glass, lit from its middle: `deep` at its rim, and `glass`
    // over it, which must fade out inside the circle (a radial gradient's
    // 100% is the box's corner, so the rim is at about 70%).
    in property <color> deep;
    in property <brush> glass;
    in property <color> rim;
    callback picked();

    width: 220px;
    height: 300px;
    background: transparent;

    // A soft glow behind the window, in the scene's own light.
    Rectangle {
        x: -16px;
        y: -16px;
        width: 252px;
        height: 252px;
        border-radius: 126px;
        background: @radial-gradient(circle, root.rim.with-alpha(0.35) 0%, root.rim.with-alpha(0.0) 66%);
        opacity: touch.pressed ? 1 : 0.6;
        animate opacity { duration: 160ms; }
    }

    Rectangle {
        width: 220px;
        height: 220px;
        y: 0;
        border-radius: 110px;
        background: root.deep;
    }

    Rectangle {
        width: 220px;
        height: 220px;
        y: 0;
        background: root.glass;
    }

    Rectangle {
        width: 220px;
        height: 220px;
        y: 0;
        border-radius: 110px;
        background: transparent;
        border-width: 6px;
        border-color: root.rim;
    }

    Text {
        y: 232px;
        width: parent.width;
        height: 36px;
        text: root.label;
        color: Theme.ink;
        font-family: Theme.font;
        font-size: 26px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        y: 266px;
        width: parent.width;
        height: 24px;
        text: root.detail;
        color: Theme.ink-faint;
        font-family: Theme.font;
        font-size: 15px;
        horizontal-alignment: center;
    }

    touch := TapArea {
        tapped => { root.picked(); }
    }
}

// The screensaver chooser a swipe down on the player opens: the Earth turning,
// the Nautilus' voyage, an invented planet, the solar tour, or any at random. A tap outside closes it.
export component ScenePicker inherits Rectangle {
    width: 1080px;
    height: 1080px;
    background: transparent;
    visible: App.choosing;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000f0;
    }

    TapArea {
        tapped => { App.choosing = false; }
    }

    Text {
        y: 150px;
        width: parent.width;
        height: 44px;
        text: "Screensaver";
        color: Theme.ink;
        font-family: Theme.font;
        font-size: 34px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        y: 198px;
        width: parent.width;
        height: 28px;
        text: "Pick what fills the glass";
        color: Theme.ink-faint;
        font-family: Theme.font;
        font-size: 18px;
        horizontal-alignment: center;
    }

    SceneTile {
        x: 540px - 20px - self.width;
        y: 250px;
        label: "Earth";
        detail: "The planet turning";
        deep: #0b2b52;
        glass: @radial-gradient(circle, #3f8fd0 0%, #1d5c97 32%, #0b2b52 52%, #0b2b5200 68%);
        rim: #7cc4ff;
        picked => {
            App.choosing = false;
            App.show-visualizer(0);
        }
    }

    SceneTile {
        x: 540px + 20px;
        y: 250px;
        label: "Nautilus";
        detail: "A voyage under the sea";
        deep: #072630;
        glass: @radial-gradient(circle, #2b7f86 0%, #134b57 32%, #072630 52%, #07263000 68%);
        rim: #c9a35a;
        picked => {
            App.choosing = false;
            App.show-visualizer(1);
        }
    }

    SceneTile {
        x: 540px - 20px - self.width;
        y: 570px;
        label: "Planet";
        detail: "An invented world";
        deep: #2a1a0c;
        glass: @radial-gradient(circle, #c9874a 0%, #7a4a22 32%, #2a1a0c 52%, #2a1a0c00 68%);
        rim: #e8b070;
        picked => {
            App.choosing = false;
            App.show-visualizer(2);
        }
    }

    SceneTile {
        x: 540px + 20px;
        y: 570px;
        label: "Solar tour";
        detail: "A grand tour of the stars";
        deep: #0a0820;
        glass: @radial-gradient(circle, #5a4ab0 0%, #2a2166 32%, #0a0820 52%, #0a082000 68%);
        rim: #a99cff;
        picked => {
            App.choosing = false;
            App.show-visualizer(3);
        }
    }

    PillButton {
        x: (parent.width - self.width) / 2;
        y: 880px;
        label: "Surprise me";
        primary: false;
        clicked => {
            App.choosing = false;
            App.show-visualizer(-1);
        }
    }
}
