import { Pointer, Theme } from "../theme.slint";
import { Idle, Player } from "../state.slint";
import { NowPlayingCard } from "../components/now_playing_card.slint";
import { SeaChart } from "sea_chart.slint";

// Taps and horizontal swipes on the visuals. Only a press that starts here
// counts: the swipe that opened the visualizer started on the player, and must
// not close it again or send it travelling when the finger lifts.
component IdleGestures inherits TouchArea {
    mouse-cursor: Pointer.plain;
    callback tapped();
    // +1 for a swipe to the left, on to what lies ahead; -1 to the right, back.
    callback swiped(int);
    // A finger held still on the scene, where it has a journey to chart.
    in property <bool> can-hold: false;
    callback held();

    private property <length> start-x: 0;
    private property <length> start-y: 0;
    private property <bool> tracking: false;
    // Movement below this is a tap; a finger always wobbles.
    private property <length> slop: 14px;
    // How far a finger must travel sideways to count as a swipe.
    private property <length> reach: 110px;

    // Held this long without moving, a press opens the chart instead, and
    // letting go does nothing more.
    Timer {
        interval: 600ms;
        running: root.tracking && root.can-hold;
        triggered => {
            if (Math.abs(root.mouse-x - root.start-x) <= root.slop
                && Math.abs(root.mouse-y - root.start-y) <= root.slop) {
                root.tracking = false;
                root.held();
            }
        }
    }

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            if (event.button != PointerEventButton.left) { return; }
            root.start-x = self.mouse-x;
            root.start-y = self.mouse-y;
            root.tracking = true;
        } else if (event.kind == PointerEventKind.up) {
            if (!root.tracking) { return; }
            root.tracking = false;
            let dx = self.mouse-x - root.start-x;
            let dy = self.mouse-y - root.start-y;
            if (Math.abs(dx) > root.reach && Math.abs(dx) > Math.abs(dy) * 1.2) {
                root.swiped(dx < 0 ? 1 : -1);
            } else if (Math.abs(dx) <= root.slop && Math.abs(dy) <= root.slop) {
                root.tapped();
            }
        } else if (event.kind == PointerEventKind.cancel) {
            root.tracking = false;
        }
    }
}

// The idle visualizer.
//
// A scene chosen at random from the renderers that came up: the Earth turning
// with its atmosphere out to the rim, or the Nautilus' voyage seen through its
// salon window. Rust draws the frames; this screen only picks the size and
// cross-fades them over the player.

export component IdleScreen inherits Rectangle {
    width: 1080px;
    height: 1080px;

    // The fade lives in the colours instead of an `opacity`, so the renderer
    // never has to composite the overlay into a cached layer. Once faded in,
    // the scene's opaque frame covers the window and this would be one more
    // full-screen layer for nothing: a transparent brush is not drawn at all.
    background: Idle.fade < 1 ? Theme.bg.with-alpha(Idle.fade) : transparent;

    // The scene frame: the globe paints the space and the air glow behind the
    // planet itself (`src/globe.rs`). The Nautilus' sea is drawn at the dive's
    // resolution, filling the panel.
    //
    // The visibility sits on a wrapper of its own. On the same element Slint
    // puts it inside the opacity, and an opacity around anything with children
    // is drawn through a layer: one at zero alpha, with nothing in it, on every
    // frame of the player, and a full-screen one through every fade. Here the
    // hidden frame skips the opacity altogether, and the image, alone under
    // it, is faded with its own alpha.
    Rectangle {
        width: Idle.frame-size;
        height: Idle.frame-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        visible: Idle.fade > 0;

        Image {
            width: 100%;
            height: 100%;
            source: Idle.frame;
            opacity: Idle.fade;
        }


    }

    // A scene's heads-up display, at the top of the circle, on one line: its
    // title, then one reading at a time (the destination, ETA, speed, ...),
    // each held a few seconds and faded into the next.
    if Idle.hud-title != "" : Rectangle {
        property <duration> hold: 4s;
        property <float> phase: Math.mod(animation-tick() / 1ms, hold / 1ms) / (hold / 1ms);
        property <int> shown: Idle.hud-lines.length > 0
            ? Math.mod(Math.floor(animation-tick() / hold), Idle.hud-lines.length) : 0;
        property <string> label: Idle.hud-lines[shown].label;
        x: (parent.width - self.width) / 2;
        y: 84px;
        width: 560px;
        height: 42px;
        border-radius: 21px;
        background: #04060cb0;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.25);
        opacity: Idle.fade;

        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: center;
            Text {
                text: label == "" ? Idle.hud-title : Idle.hud-title + "  ·  " + label.to-uppercase();
                color: Theme.accent;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 3px;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                max-width: self.preferred-width;
                text: Idle.hud-lines[shown].value;
                color: Theme.ink;
                opacity: min(1, phase * 10, (1 - phase) * 10);
                font-family: Theme.font;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // The scanner, as a cockpit readout like the engine's burn, half its
    // height, in a phosphor teal: a ladder lit to how much of the survey is
    // done, a SCAN tag pulsing while an instrument runs, and the latest two
    // readings' names, bars and results.
    if Idle.hud-scans.length > 0 : Rectangle {
        property <color> teal: #46e6c8;
        property <bool> running: Idle.hud-survey < 0.999;
        x: (parent.width - self.width) / 2;
        y: 150px;
        width: 600px;
        height: 98px;
        border-radius: 12px;
        background: #020a08d8;
        border-width: 2px;
        border-color: teal.with-alpha(0.55);
        opacity: Idle.fade;

        // The survey ladder, bottom up.
        for i in 10 : Rectangle {
            x: 22px;
            y: 74px - i * 7px;
            width: 34px;
            height: 5px;
            border-radius: 1px;
            background: Idle.hud-survey * 10 > i + 0.5 ? teal : teal.with-alpha(0.12);
        }
        Text {
            x: 14px;
            y: 80px;
            width: 50px;
            text: "SRV";
            color: teal.with-alpha(0.7);
            font-family: Theme.font;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: center;
        }

        Text {
            x: 76px;
            y: 9px;
            text: "SCANNER";
            color: teal;
            font-family: Theme.font;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 3px;
        }
        // The tag, pulsing while an instrument runs. The pulse is in the
        // colours, not an `opacity`: one around the tag and its text would
        // make Skia draw them through a layer every frame, splitting the
        // window's render pass (docs/kiosk-ui-cost.md).
        Rectangle {
            property <float> pulse: running ? 0.55 + 0.45 * Math.sin(animation-tick() / 1ms * 0.008rad) : 0.15;
            x: parent.width - 90px;
            y: 9px;
            width: 70px;
            height: 20px;
            border-radius: 4px;
            background: teal.with-alpha(pulse);
            Text {
                text: running ? "SCAN" : "DONE";
                color: #00140f.with-alpha(parent.pulse);
                font-family: Theme.font;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 3px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // The readings: the latest two, the running one last.
        for scan[i] in Idle.hud-scans : Rectangle {
            x: 76px;
            y: 38px + i * 28px;
            width: parent.width - 100px;
            height: 26px;

            Text {
                x: 0;
                y: 1px;
                width: 136px;
                text: scan.name.to-uppercase();
                color: teal.with-alpha(0.75);
                font-family: Theme.font;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2px;
                overflow: elide;
            }
            Text {
                x: 140px;
                y: -1px;
                width: parent.width - 140px;
                text: scan.value;
                color: scan.progress >= 1 ? teal : teal.with-alpha(0.5);
                font-family: Theme.font;
                font-size: 15px;
                overflow: elide;
            }
            // The bar, full once the reading is in.
            Rectangle {
                x: 0;
                y: 20px;
                width: parent.width;
                height: 3px;
                background: teal.with-alpha(0.15);
                Rectangle {
                    x: 0;
                    width: parent.width * scan.progress;
                    height: parent.height;
                    background: scan.progress >= 1 ? teal.with-alpha(0.5) : teal;
                }
            }
        }
    }

    // The manoeuvre under way, high in the circle where the scanner sits in
    // orbit, half the burn's height: its name, why the ship does it, and a
    // bar through it where it has one.
    if Idle.man-name != "" && Idle.hud-scans.length == 0 && Idle.man-dv <= 0 : Rectangle {
        x: (parent.width - self.width) / 2;
        y: 150px;
        width: 600px;
        height: 98px;
        border-radius: 16px;
        background: #04060cb0;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.25);
        opacity: Idle.fade;

        Text {
            x: 0;
            y: 7px;
            width: parent.width;
            text: Idle.man-name;
            color: Theme.accent;
            font-family: Theme.font;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 3px;
            horizontal-alignment: center;
        }
        Text {
            x: 24px;
            y: 27px;
            width: parent.width - 48px;
            height: 56px;
            text: Idle.man-text;
            color: Theme.ink;
            font-family: Theme.font;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        if Idle.man-progress >= 0 : Rectangle {
            x: 60px;
            y: parent.height - 11px;
            width: parent.width - 120px;
            height: 4px;
            border-radius: 2px;
            background: Theme.ink.with-alpha(0.12);
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * min(Idle.man-progress, 1.0);
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }

    // An engine burn, as a cockpit readout: amber on black, a ladder of
    // thrust lit to the throttle, the burn's whole change of speed set
    // against what is done of it, a pulsing BURN tag, and below, the burn's
    // stages, the one under way lit with how far through it.
    if Idle.man-name != "" && Idle.hud-scans.length == 0 && Idle.man-dv > 0 : Rectangle {
        property <color> amber: #ffb43c;
        property <float> throttle: Idle.man-throttle;
        animate throttle { duration: 250ms; }
        x: (parent.width - self.width) / 2;
        y: 150px;
        width: 600px;
        height: 196px;
        border-radius: 14px;
        background: #0a0602d8;
        border-width: 2px;
        border-color: amber.with-alpha(0.55);
        opacity: Idle.fade;

        // The thrust ladder, bottom up.
        for i in 10 : Rectangle {
            x: 22px;
            y: 160px - i * 13px;
            width: 34px;
            height: 9px;
            border-radius: 2px;
            background: throttle * 10 > i + 0.5 ? (i >= 8 ? #ff6a2a : amber) : amber.with-alpha(0.12);
        }
        Text {
            x: 14px;
            y: 172px;
            width: 50px;
            text: "THR";
            color: amber.with-alpha(0.7);
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: center;
        }

        Text {
            x: 76px;
            y: 12px;
            text: Idle.man-name;
            color: amber;
            font-family: Theme.font;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 3px;
        }
        // The tag, pulsing while the engine fires; the pulse in the colours,
        // like the scanner's.
        Rectangle {
            property <float> pulse: throttle > 0.05 ? 0.55 + 0.45 * Math.sin(animation-tick() / 1ms * 0.012rad) : 0.15;
            x: parent.width - 96px;
            y: 12px;
            width: 78px;
            height: 24px;
            border-radius: 4px;
            background: #ff6a2a.with-alpha(pulse);
            Text {
                text: "BURN";
                color: #1a0800.with-alpha(parent.pulse);
                font-family: Theme.font;
                font-size: 14px;
                font-weight: 800;
                letter-spacing: 3px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // The burn's whole change of speed, and what is done of it.
        Text {
            x: 76px;
            y: 44px;
            text: "SET";
            color: amber.with-alpha(0.6);
            font-family: Theme.font;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        Text {
            x: 118px;
            y: 38px;
            text: Math.round(Idle.man-dv * 100) / 100 + " km/s";
            color: amber;
            font-family: Theme.font;
            font-size: 22px;
            font-weight: 600;
        }
        Text {
            x: 316px;
            y: 44px;
            text: "KPS";
            color: amber.with-alpha(0.6);
            font-family: Theme.font;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        Text {
            x: 358px;
            y: 38px;
            text: Math.round(Idle.man-dv * Idle.man-done * 100) / 100 + " km/s";
            color: amber;
            font-family: Theme.font;
            font-size: 22px;
            font-weight: 600;
        }
        // How far through the burn.
        Rectangle {
            x: 76px;
            y: 74px;
            width: parent.width - 100px;
            height: 4px;
            background: amber.with-alpha(0.15);
            Rectangle {
                x: 0;
                width: parent.width * clamp(Idle.man-progress, 0, 1);
                height: parent.height;
                background: amber;
            }
        }
        // The stages: done ones dimmed and ticked off, the one under way
        // lit with a bar, the ones to come faint.
        for stage[i] in Idle.man-stages : Rectangle {
            property <bool> past: i < Idle.man-stage;
            property <bool> now: i == Idle.man-stage;
            property <color> ink: now ? amber : amber.with-alpha(past ? 0.55 : 0.28);
            x: 76px;
            y: 90px + i * 24px;
            width: parent.width - 100px;
            height: 20px;
            Text {
                x: 0;
                width: 104px;
                height: parent.height;
                text: stage.label;
                color: ink;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
            Text {
                x: 108px;
                width: parent.width - 108px - 58px;
                height: parent.height;
                text: stage.value;
                color: ink;
                font-family: Theme.font;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
            if past : Text {
                x: parent.width - 48px;
                width: 48px;
                height: parent.height;
                text: "DONE";
                color: ink;
                font-family: Theme.font;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 2px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if now : Rectangle {
                x: parent.width - 48px;
                y: (parent.height - 4px) / 2;
                width: 48px;
                height: 4px;
                background: amber.with-alpha(0.15);
                Rectangle {
                    x: 0;
                    width: parent.width * Idle.man-stage-progress;
                    height: parent.height;
                    background: amber;
                }
            }
        }
    }

    // The minimap, floating at the right of the circle: the system
    // seen tilted from above, its orbits, its planets (the stops lettered,
    // the current one in the accent), the route still to fly and the ship.
    if Idle.map-orbits != "" : Rectangle {
        x: 780px;
        y: 415px;
        width: 250px;
        height: 250px;
        // No backdrop: the map floats over the scene.
        opacity: Idle.fade;

        Rectangle {
            x: 5px;
            y: 5px;
            width: 240px;
            height: 240px;

            Path {
                x: 0;
                y: 0;
                width: 240px;
                height: 240px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 240;
                viewbox-height: 240;
                commands: Idle.map-orbits;
                stroke: Theme.ink.with-alpha(0.4);
                stroke-width: 1px;
            }
            if Idle.map-route != "" : Path {
                x: 0;
                y: 0;
                width: 240px;
                height: 240px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 240;
                viewbox-height: 240;
                commands: Idle.map-route;
                stroke: Theme.accent;
                stroke-width: 2px;
            }
            for dot in Idle.map-dots : Rectangle {
                x: dot.x - dot.size / 2;
                y: dot.y - dot.size / 2;
                width: dot.size;
                height: dot.size;
                border-radius: dot.size / 2;
                background: dot.color;
                border-width: dot.current ? 2px : 0;
                border-color: Theme.accent;

                if dot.label != "" : Text {
                    x: dot.size + 2px;
                    y: -9px;
                    text: dot.label;
                    color: dot.current ? Theme.accent : Theme.ink.with-alpha(0.75);
                    font-family: Theme.font;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
            // The ship: a bright point with a halo.
            Rectangle {
                x: Idle.map-ship-x - 6px;
                y: Idle.map-ship-y - 6px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.accent.with-alpha(0.3);
                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: #ffffff;
                }
            }
        }
    }

    // A slow breath at the rim, echoing the ring the player wears; the
    // atmosphere fades out beneath it.
    Rectangle {
        width: 1080px;
        height: 1080px;
        border-radius: 540px;
        border-width: 3px;
        border-color: Theme.accent.with-alpha(0.10 + 0.10 * Idle.fade);
        background: transparent;
        visible: Idle.scene == 0;
    }

    // Any tap leaves the visualizer and returns to the player; a swipe left or
    // right carries the dive on to the next stretch of sea, or back, and a
    // long press on the dive opens the chart of its seas.
    IdleGestures {
        enabled: Idle.fade > 0.05 && !Idle.charting;
        can-hold: Idle.scene == 1 && Idle.seas.length > 0;
        tapped => { Idle.dismiss(); }
        swiped(legs) => { Idle.travel(legs); }
        held => { Idle.charting = true; }
    }

    // What is playing, low in the circle, over the gestures so its buttons
    // take their own taps. Like the HUD it fades through an `opacity`, which
    // is 1 (no layer) once the visuals are up. Gone with them, so it never
    // takes a tap meant for the player's own transport underneath.
    if Player.has-track && Idle.fade > 0.05 : NowPlayingCard {
        x: (parent.width - self.width) / 2;
        y: 784px;
        opacity: Idle.fade;
    }

    SeaChart { }
}
